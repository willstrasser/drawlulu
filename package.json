{
  "name": "drawlulu",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "next dev",
    "dev:turbo": "next dev --turbopack",
    "dev:bot": "tsx scripts/dev-bot.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "type-check": "tsc --noEmit",
    "check": "pnpm lint && pnpm type-check && pnpm format:check && pnpm test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretest:e2e": "tsx scripts/pretest.ts",
    "test:e2e": "playwright test",
    "pretest:e2e:ui": "tsx scripts/pretest.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:db:setup": "tsx scripts/setup-test-branch.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.98.0",
    "@fal-ai/serverless-client": "^0.15.0",
    "@liveblocks/client": "^3.19.3",
    "@liveblocks/node": "^3.19.3",
    "@liveblocks/react": "^3.19.3",
    "@neondatabase/serverless": "^1.0.2",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^2.0.0",
    "@vercel/toolbar": "^0.2.6",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.1",
    "flags": "^4.0.3",
    "iron-session": "^8.0.4",
    "motion": "^12.40.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "ws": "^8.21.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^6",
    "vitest": "^4.1.8"
  }
}
